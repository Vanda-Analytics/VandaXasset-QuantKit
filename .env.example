# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# --- S3 bulk files (issued by Vanda with your data licence) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional: read a local copy instead of S3, e.g. after
#   aws s3 sync s3://vanda-analytics-samples/vandaxasset/ ./data/vandaxasset/
# VXA_DATA_ROOT=/absolute/path/to/data/vandaxasset

# --- REST API / Python SDK: set ONE of the options below ---
# Recommended: SDK key from https://www.vanda-analytics.com/tools/api-keys
VANDA_SDK_KEY=

# Or a bearer token
# VANDA_API_TOKEN=

# Or email + password (the SDK exchanges them for a token)
# VANDA_LOGIN_EMAIL=
# VANDA_PASSWORD=
